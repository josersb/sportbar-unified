# SportBar Unified - NPM Configuration
# Configuración para mantener versiones exactas y consistencia en el proyecto

# ===== VERSIONES EXACTAS =====
# Guardar dependencias con versión exacta (sin ^ o ~)
save-exact=true

# ===== PACKAGE LOCK =====
# Siempre generar package-lock.json (recomendado)
package-lock=true

# ===== SEGURIDAD =====
# Auditar automáticamente al instalar (high para reducir ruido)
audit-level=high
fund=false

# ===== SUPPLY CHAIN SECURITY (Nivel L) =====
# Bloquear scripts de instalación potencialmente maliciosos
# NOTA: Algunos paquetes necesitan build, ver allowBuilds más abajo
ignore-scripts=true

# Paquetes autorizados para ejecutar build scripts
# Incluye paquetes que sabemos que necesitan compilación nativa
allow-builds[]=@rollup/*
allow-builds[]=@vitejs/*
allow-builds[]=esbuild

# pnpm advanced security (pnpm v10+)
# Esperar 24 horas antes de instalar packages nuevos (cooldown)
# Protege contra paquetes maliciosos recién publicados
minimum-release-age=1440

# Prevenir dependencias transitive de fuentes exóticas (git, tarballs directos)
# Reduce riesgo de supply chain attacks
block-exotic-subdeps=true

# Política de confianza - prevenir downgrade de packages
# Nota: puede requerir ajustes si hay problemas
# trust-policy=no-downgrade

# ===== PERFORMANCE =====
# Usar cache para mejorar velocidad de instalación
prefer-offline=true

# ===== LOGGING =====
# Nivel de logs (silent, error, warn, notice, http, timing, info, verbose, silly)
loglevel=notice

# ===== DESARROLLO =====
# No crear archivos de respaldo (.npmrc.backup)
save-dev=false

# ===== REGISTRY =====
# Usar registry oficial de NPM (configuración explícita)
registry=https://registry.npmjs.org/

# ===== NODE VERSION =====
# Configurar motor de Node.js para el proyecto
engine-strict=true

# ===== SCRIPTS =====
# Configuración para scripts
#script-shell=auto

# ===== PROGRESO =====
# Mostrar progreso en instalaciones
progress=true

# ===== WORKSPACE (Para monorepos futuros) =====
# Configuración para workspaces si se necesita en el futuro
# workspace=false

# ===== CONFIGURACIÓN ADICIONAL SPORTBAR =====
# Omitir dependencias opcionales que no necesitamos
omit=optional

# Timeout para instalaciones (30 segundos)
fetch-timeout=30000

# Reintentos en caso de fallo
fetch-retry-maxtimeout=60000
fetch-retry-mintimeout=10000
