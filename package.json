{
  "name": "sportbar-unified",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema unificado de control SportBar - Gestión de matriz audiovisual, canales deportivos y control de audio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "cd server && pnpm install --ignore-workspace && pnpm start",
    "dev:full": "node scripts/start-dev-sequential.cjs",
    "sportbar:dev": "set PORT=3104 && pnpm run dev:full",
    "sportbar:build": "pnpm run build && set PORT=3104 && pnpm run serve",
    "start": "pnpm run build && pnpm run serve",
    "install:server": "cd server && pnpm install --ignore-workspace",
    "setup": "pnpm install && pnpm run install:server",
    "setup:auto": "node setup.js",
    "normalize-versions": "pnpm install --save-exact",
    "check-versions": "node scripts/version-manager.cjs check",
    "fix-versions": "node scripts/version-manager.cjs fix",
    "audit-versions": "node scripts/version-manager.cjs audit",
    "list-versions": "node scripts/version-manager.cjs list",
    "install-exact": "node scripts/version-manager.cjs install",
    "clean": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\" && node -e \"try{require('fs').unlinkSync('pnpm-lock.yaml')}catch(e){}\" && pnpm install",
    "clean:all": "node -e \"['node_modules','server/node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}});['pnpm-lock.yaml','server/pnpm-lock.yaml'].forEach(f=>{try{require('fs').unlinkSync(f)}catch(e){}})\" && pnpm install && cd server && pnpm install --ignore-workspace",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "lint:lockfile": "node scripts/lockfile-validator.cjs",
    "security:socket": "npx @socket_security/cli analyze --project . 2>&1 || echo 'Socket analysis not available'",
    "security:snyk": "npx snyk test",
    "security:snyk:monitor": "npx snyk monitor",
    "security:audit": "pnpm audit",
    "security:check": "node scripts/security-checker.cjs",
    "sbom": "node scripts/sbom-generator.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.1.2",
    "formik": "2.2.9",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.30.3",
    "react-select": "5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.0.17",
    "@types/react-dom": "18.0.6",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/browser": "^3.0.5",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "24.1.3",
    "lockfile-lint": "5.0.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.5",
    "snyk": "1.1304.0",
    "vite": "5.4.21",
    "vitest": "3.2.6"
  },
  "keywords": [
    "sportbar",
    "react",
    "matriz-audiovisual",
    "control-canales",
    "directv",
    "arranger"
  ],
  "author": "SportBar Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "engineStrict": true,
  "volta": {
    "node": "18.17.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.1"
  }
}
