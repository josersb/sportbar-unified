# SportBar Unified Server - NPM Configuration
# Configuración específica para el servidor Express

# ===== VERSIONES EXACTAS =====
save-exact=true

# ===== PACKAGE LOCK =====
package-lock=true

# ===== PRODUCCIÓN =====
# Configuración optimizada para servidor de producción
production=false
only=false

# ===== SEGURIDAD =====
audit-level=moderate
fund=false

# ===== PERFORMANCE =====
cache-max=86400000
prefer-offline=true

# ===== LOGGING =====
loglevel=error

# ===== REGISTRY =====
registry=https://registry.npmjs.org/

# ===== NODE VERSION =====
engine-strict=true

# ===== SERVIDOR ESPECÍFICO =====
# No instalar devDependencies en producción
dev=false

# Timeout reducido para servidor
fetch-timeout=20000

# Sin dependencias opcionales
optional=false
