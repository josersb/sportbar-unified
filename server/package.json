{
  "name": "sportbar-server",
  "version": "1.0.0",
  "description": "Express server for SportBar unified application",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "check-versions": "pnpm list --depth=0",
    "clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "dependencies": {
    "express": "4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "lowdb": "7.0.1",
    "path-to-regexp": "0.1.13",
    "ws": "8.18.2"
  },
  "devDependencies": {
    "nodemon": "2.0.20"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.3",
      "path-to-regexp": "0.1.13",
      "qs@>=6.0.0 <6.14.1": "6.14.1",
      "semver@>=7.0.0 <7.5.2": "7.5.2"
    }
  },
  "keywords": [
    "express",
    "sportbar",
    "server",
    "production"
  ],
  "author": "SportBar Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "engineStrict": true,
  "volta": {
    "node": "18.17.1"
  }
}
